ADMIN_PASSWORD=medixadmin2026
ADMIN_SESSION_SECRET=cambia-este-secreto

# Bot solo WhatsApp (sin enlaces a la web). true por defecto.
WHATSAPP_STANDALONE=true

# URL HTTPS pública del servidor del bot (solo para el webhook de Meta).
# No es la tienda para clientes; es donde vive /api/whatsapp/webhook
NEXT_PUBLIC_SITE_URL=https://tu-servidor.vercel.app

# WhatsApp Cloud API (Meta)
# 1. Crea una app en https://developers.facebook.com/
# 2. Agrega el producto WhatsApp
# 3. Copia el token y el Phone number ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=medix-verify-token
# Opcional pero recomendado: App Secret para validar firmas del webhook
WHATSAPP_APP_SECRET=
# Solo si necesitas /api/whatsapp/simulate en producción sin admin
# WHATSAPP_ALLOW_SIMULATE=true
