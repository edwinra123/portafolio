ADMIN_PASSWORD=medixadmin2026
ADMIN_SESSION_SECRET=cambia-este-secreto

# URL pública de la tienda (para enlaces del bot de WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (Meta)
# 1. Crea una app en https://developers.facebook.com/
# 2. Agrega el producto WhatsApp
# 3. Copia el token temporal (o permanente) y el Phone number ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=medix-verify-token
# Opcional pero recomendado: App Secret para validar firmas del webhook
WHATSAPP_APP_SECRET=
# Solo si necesitas /api/whatsapp/simulate en producción
# WHATSAPP_ALLOW_SIMULATE=true
